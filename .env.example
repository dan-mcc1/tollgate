DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/example_db
UPSTREAM_BASE_URL=http://localhost:8001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
MOCK_GEMINI=True

# Rate limiting. "memory" needs nothing; "redis" is the one that holds across containers.
LIMITER_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Telemetry. Off by default; the scrape endpoint lists tenant names and spend, so it is
# enabled for local development only and never in production, which pushes over OTLP.
OTEL_ENABLED=False
METRICS_ENDPOINT_ENABLED=True
OTEL_CONSOLE=False
# OTEL_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# OTEL_HEADERS=Authorization=Basic <base64 of instanceID:token>

# Detection. The fleet-wide switch for inspecting input; what happens to a flagged request
# is per tenant (`tollgate set-detection <tenant> --mode off|monitor|block`) and defaults to
# monitor, so nothing is refused until the eval's false positive rate has been read.
DETECTION_ENABLED=True

# Which ONNX classifier runs behind the regex baseline: "deberta-base", "tiny", or empty for the
# baseline alone. Empty is what ships, and that is a measurement: `tiny` flags 43% of ordinary
# short prompts, and `deberta-base` is accurate but costs 35 ms at the median, which is more
# overhead than this gateway claims to add. See the Results section. Fetch a model before naming
# one, or the gateway refuses to start rather than pretending a regex is a classifier:
#
#   uv run python -m tollgate.detect.fetch tiny
#
DETECTION_CLASSIFIER_MODEL=
DETECTION_MODEL_DIR=models
# Empty means the threshold measured for that model, recorded on its registry entry in
# detect/classifier.py. Set one only to override a measurement with an opinion.
# DETECTION_THRESHOLD=
# Inference budget per request, spent window by window. A prompt too long for it is inspected
# as far as the budget reached; the regex baseline has read the whole thing regardless.
DETECTION_TIMEOUT_MS=250
DETECTION_THREADS=1
DETECTION_MAX_WINDOWS=4
DETECTION_WINDOW_STRIDE_TOKENS=64
# Output scanning on a stream, in block mode only: how far behind the upstream the relay runs,
# so a credential can be caught while it is still held rather than after it has been sent. This
# is the length of leak that can still be contained, and it costs time to first token. Monitor
# mode holds nothing back, because delaying a stream to do nothing about what is found is pure
# latency.
DETECTION_STREAM_HOLDBACK_BYTES=1024

# Caching. Entries are always scoped to one tenant; there is no setting for sharing them.
# The temperature ceiling is what keeps sampled output out of the cache: a request naming
# no temperature is served at the provider's default of 1.0, so it is bypassed.
CACHE_ENABLED=True
CACHE_TTL_S=86400
CACHE_MAX_TEMPERATURE=0.0
CACHE_ASSUMED_TEMPERATURE=1.0
CACHE_MAX_RESPONSE_BYTES=262144

# The semantic tier: answering from a similar request rather than an identical one.
# Off, and with no threshold, on purpose. A threshold belongs to the embedding model it
# was swept against: bench/cache_sweep.py found 0.93 safe for the mock's embeddings and
# *no* safe value at all for gemini-embedding-001. Setting ENABLED without a THRESHOLD
# refuses to start, so run the sweep against the embeddings you will actually use.
CACHE_SEMANTIC_ENABLED=False
# CACHE_SEMANTIC_THRESHOLD=
CACHE_EMBEDDING_MODEL=gemini-embedding-001
CACHE_EMBEDDING_DIMENSIONS=768
CACHE_EMBEDDING_TIMEOUT_S=2.0
CACHE_HNSW_EF_SEARCH=100

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Classifier graphs: hundreds of megabytes, fetched and checksum-verified by
# `python -m tollgate.detect.fetch`, pinned by revision and hash in detect/classifier.py.
models/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Terraform: provider downloads and local state never get committed.
# (.terraform.lock.hcl DOES get committed: it pins provider versions, like uv.lock.)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Per-person values (like an alert email) stay out of a public repo; see *.tfvars.example.
terraform.tfvars
crash.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Hits by tier",
      "description": "Exact hits against semantic hits, per minute. The two are worth separating because they cost different things to find: an exact hit is one indexed read, and a semantic hit was preceded by an embedding call that every miss under that tier also paid for.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(tollgate_cache_lookups_total{tenant=~\"$tenant\", result=~\"exact|semantic\"}[$__rate_interval])) * 60",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Semantic tier, net",
      "description": "What the semantic tier saved over this range, minus what it spent on embeddings to find it - including the embeddings for every request that found nothing. Negative means the tier is costing more than it saves on this traffic, which is the number that decides whether to leave it on. Reads zero while the tier is off, which is how the gateway ships.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(tollgate_cache_savings_total{tenant=~\"$tenant\", tier=\"semantic\"}[$__range])) - sum(increase(tollgate_cache_embedding_spend_total{tenant=~\"$tenant\"}[$__range]))) / 100000000",
          "legendFormat": "net"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "text",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Spent looking",
      "description": "Dollars spent on embeddings over this range. Paid on every request the semantic tier examined, whether or not it found anything, which is why it is shown rather than folded into the saving beside it.",

            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Cache outcomes",
      "description": "Requests a minute by what the cache did with them. 'miss' and a hit tier are the two that move with traffic; a step change in 'bypass' means a tenant changed how it calls the gateway, not that anything here broke.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(tollgate_cache_lookups_total{tenant=~\"$tenant\"}[$__rate_interval])) * 60",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Spend, paid against avoided",
      "description": "Dollars an hour leaving for the provider, and dollars an hour the cache kept. The pair is what makes the cache's value legible: the second line is only worth anything relative to the first.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tollgate_spend_total{tenant=~\"$tenant\"}[$__rate_interval])) * 3600 / 100000000",
          "legendFormat": "paid upstream"
        },
        {
          "refId": "B",
          "expr": "sum(rate(tollgate_cache_savings_total{tenant=~\"$tenant\"}[$__rate_interval])) * 3600 / 100000000",
          "legendFormat": "avoided by the cache"
        }
